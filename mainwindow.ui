           <item>
            <widget class="QFrame" name="frame">
             <property name="styleSheet">
              <string notr="true">QFrame#frame{background-color: #f0f0f0;}</string>
             </property>
             <property name="frameShape">
              <enum>QFrame::StyledPanel</enum>
