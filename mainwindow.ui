                  <property name="styleSheet">
                   <string notr="true">/* 1. ComboBox 主体 */
QComboBox {
    border: 1px solid #A0C4DE;      /* 边框颜色 */
    border-radius: 4px;
    padding: 1px 10px 1px 10px;     /* 文字内边距 */
    background-color: white;
   font-family: &quot;Microsoft YaHei UI&quot;, &quot;Segoe UI&quot;;
    color: #333333;
    font-size: 12px;
    min-height: 28px;
}

/* 2. 下拉按钮区域（右侧那个小格子） */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px; 
    /* 关键：添加左边框，使箭头按钮与左侧选择区产生视觉隔离，不再“融合” */
    border-left: 1px solid #CFD8DC; 
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #F8FBFF;      /* 给按钮区一个极淡的背景色，增加层次感 */
}

/* 3. 调用你的 aarrow 图片 */
QComboBox::down-arrow {
    image: url(:/img/arrow.png);   /* 这里就是调用你新增资源的地方 */
    width: 12px;                    /* 根据你图片的实际大小微调 */
    height: 12px;
}

/* 4. 悬停状态 */
QComboBox:hover {
    border: 1px solid #0078D4;
}

/* 5. 下拉列表项样式 */
QComboBox QAbstractItemView {
    border: 1px solid #A0C4DE;
    background-color: white;
    selection-background-color: #0078D4;
    outline: 0px;
}</string>
                  </property>
