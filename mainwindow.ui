         <item>
          <widget class="QTabWidget" name="tabWidget_Tool">
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>0</height>
            </size>
           </property>
           <property name="font">
            <font>
             <family>Microsoft YaHei UI</family>
             <pointsize>10</pointsize>
             <bold>false</bold>
            </font>
           </property>
           <property name="autoFillBackground">
            <bool>false</bool>
           </property>
           <property name="styleSheet">
            <string notr="true">/* --- 全局容器 --- */
QTabWidget {
    background-color: white;
}

/* --- 1. 面板区域：贯穿全局的浅蓝色细线 --- */
QTabWidget::pane {
    border-top: 1px solid #A0C4DE; 
    background: white;
    /* 绝对定位确保线条与标签无缝衔接 */
    position: absolute;
    top: -1px; 
}

/* --- 2. 标签栏整体 --- */
QTabBar {
    background: transparent;
}

/* --- 3. 基础标签样式（未选中状态） --- */
QTabBar::tab {
    background: transparent;
    color: #4D6D8B;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;;
    
    /* [修改] 字体改大 */
    font-size: 14px; 
    
    /* [修改] 增加内边距：
       - 上下 8px：让 Tab 变高
       - 左右 30px：让 Tab 变宽，且给粗体字预留膨胀空间 */
    padding: 2px 15px; 
    
    /* [修改] 最小宽度：防止只有2个字的短标题被切 */
    min-width: 80px;

    margin-right: 1px;

    /* --- [关键修改] 透明边框占位 --- 
       这里必须设置得和“选中状态”的边框厚度一模一样！
       这样切换时，内容区域才不会因为边框出现而被挤压。 */
    border-top: 2px solid transparent; 
    border-left: 1px solid transparent;
    border-right: 1px solid transparent;
    border-bottom: 2px solid transparent; 
}

/* --- 4. 选中状态 --- */
QTabBar::tab:selected {
    background: white; 
    color: #0078D4;
    font-weight: bold;

    /* --- 改变边框颜色（厚度由上面第3部分决定，这里不重复写width） --- */
    border-top-color: #0078D4;    /* 顶部变蓝 */
    border-left-color: #A0C4DE;   /* 左侧淡蓝 */
    border-right-color: #A0C4DE;  /* 右侧淡蓝 */

    /* 底部用白色覆盖 Pane 的线条 */
    border-bottom-color: white; 
    
    /* 负边距确保压在 Pane 线上 */
    margin-bottom: -1px; 
}

/* --- 5. 悬停微调 --- */
QTabBar::tab:hover:!selected {
    background-color: #F5F8FA;
    color: #005691;
}

/* --- 6. 高度补偿（已不再需要） --- */
/* 由于我们在第3部分加了3px的透明顶边框，未选中状态自然就有了高度。
   为了保证对齐最稳，这里建议删去 margin-top 的设置 */
QTabBar::tab:!selected {
    margin-top: 0px; 
}</string>
