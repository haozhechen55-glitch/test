                  <property name="styleSheet">
                   <string notr="true">border:none;
/* 默认状态（未播放）：显示播放图标 */
QToolButton#toolButton_play {
    /* 你的图标路径 */
    qproperty-icon: url(:/icons/play.png);
    background-color: transparent; /* 或者你想要的颜色 */
}

/* 选中状态（正在播放）：显示暂停图标 */
QToolButton#toolButton_play:checked {
    /* 你的图标路径 */
    qproperty-icon: url(:/icons/pause.png);
    /* 选中时通常背景会变深，表示正在运行 */
    background-color: transparent; 
    border: 1px solid #A0C4DE;
}</string>
                  </property>
