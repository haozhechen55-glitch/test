                  <property name="styleSheet">
                   <string notr="true">/* 统一设置 QLineEdit 的风格，使其与 ComboBox 和 TreeView 协调 */
QLineEdit {
    /* 1. 字体统一 */
    font-family: &quot;Microsoft YaHei UI&quot;, &quot;Segoe UI&quot;;
    font-size: 10pt;  /* 与你的 ToolButton 大小一致 */
    color: #333333;

    /* 2. 边框风格（参考了你的 ComboBox 颜色 #A0C4DE） */
    border: 1px solid #A0C4DE;
    border-radius: 4px;       /* 圆角 */
    padding: 2px 5px;         /* 内边距，让文字不要贴着边框 */
    background-color: #FFFFFF;
}

/* 3. 鼠标悬停或输入时的交互效果 */
QLineEdit:hover {
    border: 1px solid #0078D4; /* 悬停时变蓝 */
}

QLineEdit:focus {
    border: 1px solid #0078D4; /* 聚焦时变蓝 */
    background-color: #F8FBFF; /* 背景变极淡的蓝，增加聚焦感 */
}</string>
                  </property>
                  <property name="placeholderText">
                   <string>GaussianRadius</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QLineEdit" name="lineEdit_PointSize">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
