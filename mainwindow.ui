                  <widget class="QWidget" name="widget" native="true">
                   <property name="styleSheet">
                    <string notr="true">
/* 标签样式：模仿选中状态的 Tab */
QLabel {
    background-color: #FFFFFF;    /* 背景纯白，与 Tab 内容区一致 */
    color: #202020;               /* 字体颜色加深，匹配选中状态 */
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;;
    padding: 6px 12px;            /* 内边距调整为与 Tab 一致 */

    /* 边框设计：统一色调 */
    border-left: 1px solid #BFBFBF;   /* 与 TabPane 边框颜色一致 */
    border-right: 1px solid #BFBFBF;
    border-bottom: 1px solid #FFFFFF; /* 关键：底部白色，打通下方区域 */
    
    /* 核心特征：顶部蓝色强调条 */
    border-top: 3px solid #007ACC;    

    /* 圆角 */
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;

    /* 布局位置 */
    margin-bottom: -1px;          /* 关键：向下偏移1px，覆盖下方控件的边框 */
    margin-left: 2px;             /* 左侧对齐微调 */
}

/* 2. 控制台文本框样式 */
QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #8C98A5;    /* 完整的边框 */
    border-radius: 3px;
    /* 只有右上和右下圆角，左上角因为被标签压住，也可以保留圆角 */
}</string>
                   </property>
                   <layout class="QVBoxLayout" name="verticalLayout_6">
                    <property name="spacing">
                     <number>0</number>
                    </property>
                    <property name="leftMargin">
                     <number>0</number>
                    </property>
                    <property name="topMargin">
                     <number>0</number>
                    </property>
                    <property name="rightMargin">
                     <number>0</number>
                    </property>
                    <property name="bottomMargin">
                     <number>0</number>
                    </property>
                    <item>
                     <widget class="QLabel" name="label">
                      <property name="sizePolicy">
                       <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                        <horstretch>0</horstretch>
                        <verstretch>0</verstretch>
                       </sizepolicy>
                      </property>
                      <property name="text">
                       <string>Console</string>
                      </property>
                     </widget>
                    </item>
                    <item>
                     <widget class="QTextEdit" name="textEdit_log">
                      <property name="styleSheet">
                       <string notr="true">QTextEdit#textEdit_log {
    /* 1. 背景与文字：使用护眼的纯白背景和深灰文字 */
    background-color: #FFFFFF;
    color: #333333;
    font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace;
    font-size: 10pt;

    /* 2. 边框核心设计（微立体感的来源） */
    border-style: solid;
    border-width: 1px;
    border-radius: 3px; /* 3px 圆角，比直角柔和，比圆角方正 */

    /* 技巧：让上边框比其他三边稍微深一点点，模拟顶光产生的内阴影 */
    border-top-color: #8C98A5;    /* 顶部：深灰蓝 */
    border-left-color: #B0BCC9;   /* 左侧：中灰蓝 */
    border-right-color: #CDE0F0;  /* 右侧：浅灰蓝 */
    border-bottom-color: #CDE0F0; /* 底部：浅灰蓝 (模拟反光) */

    /* 3. 内边距：文字离边框稍微远一点，呼吸感更强 */
    padding: 6px;
}

/* 4. 交互反馈：当鼠标点进去输入时，边框变成专业蓝，提示“已激活” */
QTextEdit#textEdit_log:focus {
    border: 1px solid #3182CE; /* 聚焦时的亮蓝色 */
    background-color: #F8FBFF; /* 背景极淡的蓝色，增强聚焦感 */
}</string>
                      </property>
                      <property name="frameShadow">
                       <enum>QFrame::Sunken</enum>
                      </property>
                     </widget>
                    </item>
                   </layout>
                  </widget>
                 </widget>
                </item>
                <item>
                 <widget class="QProgressBar" name="progressBar">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Minimum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="maximumSize">
                   <size>
                    <width>16777215</width>
                    <height>5</height>
                   </size>
                  </property>
                  <property name="value">
                   <number>0</number>
                  </property>
                  <property name="textVisible">
                   <bool>false</bool>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
 </widget>
