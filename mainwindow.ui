              <item>
               <widget class="QTreeView" name="treeView_left">
                <property name="styleSheet">
                 <string notr="true">/* --- 1. 树控件整体 --- */
QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #CFD8DC;
    border-radius: 4px;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;;
    font-size: 11pt;
    outline: 0;                 /* 去掉聚焦时的虚线框 */
    padding: 0px;
    
    /* 【关键】开启此属性，让 Item 的样式能控制整行（包括箭头区域） */
    qproperty-showDecorationSelected: 1; 
}

/* --- 2. 每一行（基础态） --- */
QTreeView::item {
    height: 32px;
    border: none;
    color: #546E7A;             /* 未选中时的文字颜色 */
    padding-left: 6px;
    background-color: #FFFFFF;  /* 默认背景白 */
}

/* --- 3. 鼠标悬停态 --- */
/* 如果您连悬停的极淡灰色都不想要，就把这里的 #FAFAFA 改成 #FFFFFF */
QTreeView::item:hover {
    background-color: #FAFAFA;  
    color: #263238;
}

/* --- 4. 选中状态（激活/获取焦点时） --- */
QTreeView::item:selected {
    /* 【核心】背景强制设为白色，彻底消灭色块 */
    background-color: #FFFFFF; 
    
    /* 仅通过文字变色来提示选中 */
    color: #2196F3;
    font-weight: bold;
    
    /* 左侧 2px 蓝色细条指示 */
    border-left: 2px solid #2196F3;
}

/* --- 5. 选中状态（失去焦点时） --- */
/* 防止点击其他窗口后，这里变成灰块 */
QTreeView::item:selected:!active {
    background-color: #FFFFFF;  /* 【核心】这里也要白 */
    color: #90A4AE;             /* 文字变灰一点 */
    border-left: 2px solid #CFD8DC; /* 左侧条变灰 */
}

/* --- 6. 分支区域（箭头所在列） --- */
QTreeView::branch {
    background-color: #FFFFFF; /* 强制背景白 */
}
QTreeView::branch:selected {
    background-color: #FFFFFF; /* 强制选中时背景也白 */
}</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QListWidget" name="listWidget_frames">
                <property name="styleSheet">
                 <string notr="true">/* --- 1. 列表控件整体 --- */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #CFD8DC;
    border-radius: 4px;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;;
    font-size: 11pt;
    outline: 0;                 /* 去掉聚焦时的虚线框 */
    padding: 0px;
    
    /* 【关键】开启此属性，让 Item 的样式能控制整行 */
    qproperty-showDecorationSelected: 1; 
}

/* --- 2. 每一行（基础态） --- */
QListWidget::item {
    height: 32px;
    border: none; /* 必须先清空默认边框，否则下面的 border-left 可能显示异常 */
    border-left: 2px solid transparent; /* 预留左侧边框位置，防止选中时抖动 */
    color: #546E7A;             /* 未选中时的文字颜色 */
    padding-left: 4px;          /* 稍微调整内边距，因为左侧有2px边框 */
    background-color: #FFFFFF;  /* 默认背景白 */
}

/* --- 3. 鼠标悬停态 --- */
QListWidget::item:hover {
    background-color: #FAFAFA;  
    color: #263238;
}

/* --- 4. 选中状态（激活/获取焦点时） --- */
QListWidget::item:selected {
    /* 【核心】背景强制设为白色，彻底消灭色块 */
    background-color: #FFFFFF; 
    
    /* 仅通过文字变色来提示选中 */
    color: #2196F3;
    font-weight: bold;
    
    /* 左侧 2px 蓝色细条指示 */
    border-left: 2px solid #2196F3;
}

/* --- 5. 选中状态（失去焦点时） --- */
/* 防止点击其他窗口后，这里变成灰块 */
QListWidget::item:selected:!active {
    background-color: #FFFFFF;  /* 【核心】这里也要白 */
    color: #90A4AE;             /* 文字变灰一点 */
    border-left: 2px solid #CFD8DC; /* 左侧条变灰 */
}</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QFrame" name="frame_2">
             <property name="styleSheet">
              <string notr="true">QFrame#frame_2{background-color: #f0f0f0;}</string>
             </property>
             <property name="frameShape">
              <enum>QFrame::StyledPanel</enum>
             </property>
             <property name="frameShadow">
              <enum>QFrame::Raised</enum>
             </property>
             <layout class="QVBoxLayout" name="verticalLayout_9">
              <item>
               <layout class="QVBoxLayout" name="verticalLayout_5">
                <item>
                 <widget class="QSplitter" name="splitter">
                  <property name="orientation">
                   <enum>Qt::Vertical</enum>
                  </property>
                  <widget class="QTabWidget" name="tabWidget_center">
                   <property name="font">
                    <font>
                     <family>Segoe UI</family>
                     <pointsize>10</pointsize>
                     <italic>false</italic>
                     <bold>true</bold>
                     <stylestrategy>PreferAntialias</stylestrategy>
                    </font>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">/* 1. 整体容器：去掉默认的浮雕边框 */
QTabWidget#tabWidget_center::pane {
    border: 1px solid #C0C0C0; /* 柔和的灰色边框 */
    background: white;         /* 内容区背景纯白 */
    top: -1px;                 /* 稍微向上移，盖住 TabBar 的底边，形成一体感 */
}

/* 2. Tab 条的背景 */
QTabWidget#tabWidget_center QTabBar {
    background: #F0F0F0;       /* Tab 栏背景略灰，区分内容区 */
}

/* 3. 单个标签页的基础样式 */
QTabWidget#tabWidget_center QTabBar::tab {
    background: #E1E1E1;       /* 未选中时：浅灰色 */
    border: 1px solid #C0C0C0; /* 边框 */
    border-bottom-color: #C0C0C0; 
    min-width: 100px;          /* 最小宽度 */
    padding: 6px 15px;         /* 内边距，让文字不拥挤 */
    color: #555555;            /* 文字深灰 */
    border-top-left-radius: 4px;  /* 左上角圆角 */
    border-top-right-radius: 4px; /* 右上角圆角 */
    margin-right: 2px;         /* 标签之间的间隔 */
}

/* 4. 鼠标悬停样式 */
QTabWidget#tabWidget_center QTabBar::tab:hover {
    background: #F5F5F5;       /* 稍微变亮 */
    color: #333333;
}

/* 5. 选中状态（激活）样式 - 核心 */
QTabWidget#tabWidget_center QTabBar::tab:selected {
    background: white;         /* 选中变为白色，与下方内容融合 */
    border-bottom-color: white;/* 底部边框变白，打通内容区 */
    border-top: 3px solid #0078D7; /* 顶部加一条蓝色强调线 */
}

/* 6. 处理非选中项看起来太靠下的问题 */
QTabWidget#tabWidget_center QTabBar::tab:!selected {
    margin-top: 3px; /* 让未选中的矮一点，突出选中的 */
}</string>
                   </property>
