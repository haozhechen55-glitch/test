     <property name="styleSheet">
      <string notr="true">/* ================= 全局字体与背景优化 ================= */
QWidget {
    /* 优先使用微软雅黑，兼顾英文 Segoe UI */
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 12px;  /* 字体稍微大一点，看起来更现代 */
    color: #333333;   /* 不要用纯黑，用深灰色，视觉更柔和 */
}

/* ================= 标签样式 ================= */
QLabel {
    /* 增加一点行高或内边距，防止文字太挤 */
    padding: 2px;
}

/* ================= 复选框 (QCheckBox) 美化 ================= */
QCheckBox {
    spacing: 8px; /* 文字和方框之间的距离 */
    outline: none; /* 去掉点击时的虚线框 */
}

/* 1. 复选框的“外壳” (指示器) - 未选中状态 */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #ffffff;
    border: 1px solid #cccccc; /* 浅灰色边框 */
    border-radius: 4px;        /* 小圆角 */
}

/* 2. 鼠标悬停时 - 边框变蓝 */
QCheckBox::indicator:hover {
    border-color: #0078d4; 
}

/* 3. 选中状态 - 变成蓝色背景 */
QCheckBox::indicator:checked {
    background-color: #0078d4; /* 微软/Qt 常见的主题蓝 */
    border-color: #0078d4;
    
    /* 【注意】：这里需要一个对号图标。
    
    */
    image: url(:/img/tick.png); 
}

/* 4. 禁用状态 (可选) */
QCheckBox::indicator:disabled {
    background-color: #f0f0f0;
    border-color: #dddddd;
}
</string>
