        <property name="styleSheet">
         <string notr="true">QTabWidget::pane {
    border: 1px solid #b6c7ea;
    background: #f5f5f5;
}


QTabBar::tab {
    background: white;
    color: #333333;
    padding: 8px 16px;
    margin: 0px;
    font-size: 8pt;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
    border: 1px solid #b6c7ea;
    border-bottom: 1px solid transparent;
    min-width: 80px;
    text-align: center;
}

QTabBar::tab:selected {
    background: #f0f5ff;
    color: #0057b7;
    font-weight: bold;
    border-bottom: 2px solid #0078d4;
}

QTabBar::tab:hover {
    background: #f8f8f8;
    color: #222222;
}

QTabBar::tab:selected:hover {
    background: #e6f0ff;
}
/* 通用的输入框样式 */
QLineEdit, QComboBox {
font-family: &quot;Microsoft YaHei&quot;, &quot;SimSun&quot;, sans-serif; /* 与你其他控件保持一致 */
    font-size: 14px;       /* 你可以自己调整大小，通常按钮字号比正文稍大或持平 */
    border: 1px solid #cccccc;       /* 浅灰色边框，定义轮廓 */
    border-radius: 3px;              /* 小圆角，看起来不生硬 */
    padding: 3px 5px;                /* 内边距，文字不要贴着边框 */
    background-color: #ffffff;       /* 保持白色背景 */
    color: #333333;                  /* 深色文字 */
    selection-background-color: #0078d4; /* 选中文字时的蓝色背景 */
}

/* 鼠标悬停时，边框稍微变深 */
QLineEdit:hover, QComboBox:hover {
    border-color: #999999;
}

/* 获得焦点（正在输入）时，边框变成主题蓝 */
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #0057b7;
    background-color: #ffffff; 
}

/* 禁用状态（灰色不可点） */
QLineEdit:disabled, QComboBox:disabled {
    background-color: #f5f5f5;
    border-color: #dcdcdc;
    color: #a0a0a0;
}


/* 强制所有按钮使用统一字体和大小 */
QPushButton {
    font-family: &quot;Microsoft YaHei&quot;, &quot;SimSun&quot;, sans-serif; /* 与你其他控件保持一致 */
    font-size: 14px;       /* 你可以自己调整大小，通常按钮字号比正文稍大或持平 */
    
}

</string>
